# Bot token from Discord Developer Portal -> Bot
DISCORD_TOKEN=PASTE_TOKEN_HERE

# Your Discord server ID
GUILD_ID=PASTE_SERVER_ID_HERE

# Having this role activates AutoJail. This role is kept on the member.
JAIL_TRIGGER_ROLE_ID=PASTE_TRIGGER_ROLE_ID_HERE

# This additional role is given to jailed members.
JAIL_ROLE_ID=PASTE_JAIL_ROLE_ID_HERE

# Official Geeked Server Booster role. Members with this role can configure one
# personal role. Discord's premiumSince status is also accepted.
BOOSTER_ROLE_ID=1369776914016899204

# Only these Geeked staff roles can run /booster-panel, /booster-cleanup,
# every /security subcommand, and /reaction-role sync or status.
# Separate role IDs with commas. The server owner is always allowed.
BOOSTER_STAFF_ROLE_IDS=1478058575149531300,1456339648187072625,1449402351793471488,1522528313061539850,1401221741665062962,1410006517083537411,1492287102589731107,1374039598019379302

# Strongly recommended: channel used for AutoJail and /security logs.
# Leave empty only if you intentionally do not want security logs.
LOG_CHANNEL_ID=

# Optional: separate channel for Components V2 booster-stop logs.
# When empty, the bot automatically uses LOG_CHANNEL_ID above.
BOOSTER_LOG_CHANNEL_ID=

# Separate moderation log for every created or edited custom booster role.
# Add the channel ID here so staff can review names and icons for NSFW content.
BOOSTER_ROLE_LOG_CHANNEL_ID=

# Known personal-role owners are checked directly through Discord REST.
# This does not require the privileged Server Members Intent.
BOOSTER_CHECK_INTERVAL_MINUTES=5

# Rotating English bot presence. Uses Discord's approximate non-offline count.
# No Presence Intent is required.
STATUS_ENABLED=true
STATUS_SERVER_NAME=Geeked
STATUS_ROTATION_SECONDS=30
STATUS_REFRESH_MINUTES=2

# Checks the latest 100 member-role audit-log entries after every restart.
CHECK_RECENT_ON_START=true

# Wait briefly so Discord has finished applying a role update.
DEBOUNCE_MS=800

# The booster-role system needs no database and no additional variables.
# It creates two empty role markers automatically on the first start.

# Optional secure web dashboard. Leave disabled until GitHub Pages, the
# Cloudflare Worker and D1 have been deployed using DASHBOARD-SETUP-DE.md.
DASHBOARD_ENABLED=false
DASHBOARD_API_URL=https://geeked-dashboard-api.YOUR_SUBDOMAIN.workers.dev

# Must be exactly the same random BOT_SYNC_TOKEN stored as a Cloudflare secret.
# Never commit this value or place it in the public GitHub Pages files.
DASHBOARD_SYNC_TOKEN=PASTE_A_LONG_RANDOM_SECRET

# The bot checks for a new saved dashboard revision every 30-300 seconds.
DASHBOARD_SYNC_SECONDS=60

# Optional path for reaction-role deployment metadata. This JSON stores only
# panel IDs, channel IDs, and message IDs, never member IDs or assigned roles.
# Keep the default unless your host uses a separate persistent volume.
REACTION_ROLE_STATE_PATH=./data/reaction-role-state.json
