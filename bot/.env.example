# Required: bot token from Discord Developer Portal -> Bot
DISCORD_TOKEN=PASTE_TOKEN_HERE

# Optional legacy server. Existing single-server .env values below are used only
# for this server until its first dashboard configuration is saved.
GUILD_ID=PASTE_EXISTING_SERVER_ID_HERE
AUTOJAIL_ENABLED=false
JAIL_TRIGGER_ROLE_ID=
JAIL_ROLE_ID=
BOOSTER_ROLE_ID=
BOOSTER_STAFF_ROLE_IDS=
LOG_CHANNEL_ID=
BOOSTER_LOG_CHANNEL_ID=
BOOSTER_ROLE_LOG_CHANNEL_ID=

# The global bot presence reads counts only from this server. Leave it equal to
# the Geeked server ID. If empty, GUILD_ID is used for backward compatibility.
STATUS_GUILD_ID=PASTE_GEEKED_SERVER_ID_HERE
STATUS_ENABLED=true
STATUS_SERVER_NAME=Geeked
STATUS_ROTATION_SECONDS=30
STATUS_REFRESH_MINUTES=2

# Shared runtime behavior for every server
BOOSTER_CHECK_INTERVAL_MINUTES=5
CHECK_RECENT_ON_START=true
DEBOUNCE_MS=800

# Multi-server dashboard
DASHBOARD_ENABLED=true
DASHBOARD_API_URL=https://geeked-dashboard-api.YOUR_SUBDOMAIN.workers.dev
DASHBOARD_SYNC_TOKEN=PASTE_THE_SAME_BOT_SYNC_TOKEN_AS_CLOUDFLARE
DASHBOARD_SYNC_SECONDS=60

# Only panel deployment metadata is stored locally. The bot automatically adds
# the server ID to this filename so different servers can never share state.
REACTION_ROLE_STATE_PATH=./data/reaction-role-state.json
